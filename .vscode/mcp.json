{
  "servers": {
    "useful-mcp-server": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["${workspaceFolder}/server.py"],
      "cwd": "${workspaceFolder}",
      "env": {
        "MCP_TRANSPORT": "stdio"
      },
      "envFile": "${workspaceFolder}/.env"
    }
  }
}
