# Optional. Web search is disabled until a Tavily key is supplied.
TAVILY_API_KEY=

# Optional. News search is disabled until a NewsAPI key is supplied.
NEWSAPI_API_KEY=

# stdio is suitable for desktop MCP clients; use http to run a local service.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Chatbot web app. Set these in .env or your deployment's secret manager.
CHATBOT_USERNAME=admin
CHATBOT_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-a-random-secret
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
APP_ENV=development
CHATBOT_HOST=127.0.0.1
CHATBOT_PORT=8080
